# Runtime
TZ=Europe/Paris
GLUETUN_LOG_LEVEL=info

# Proton VPN Plus, using WireGuard. Fill in the provider-issued key before starting.
VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=wireguard

# Proton server selection (Plus plan, P2P-capable servers)
SERVER_COUNTRIES=Belgium
SERVER_CITIES=''
SERVER_HOSTNAMES=''
FREE_ONLY=off
PORT_FORWARD_ONLY=on
# Enable only with a Proton WireGuard key generated with NAT-PMP enabled.
VPN_PORT_FORWARDING=off

# WireGuard credentials from the Proton dashboard
# Copy PrivateKey from [Interface]; do not use the Proton account password.
# An optional data/wireguard/wg0.conf overrides the corresponding variables.
WIREGUARD_PRIVATE_KEY=''
# Match Address from the generated configuration.
WIREGUARD_ADDRESSES='10.2.0.2/32'
# Server public key and endpoint are required for a custom WireGuard provider.
WIREGUARD_PUBLIC_KEY=''
WIREGUARD_ENDPOINT_IP=''
# Use the endpoint port supplied by the VPN provider (often 51820).
WIREGUARD_ENDPOINT_PORT=''
WIREGUARD_PRESHARED_KEY=''

# OpenVPN credentials (used only when VPN_TYPE=openvpn)
OPENVPN_USER=''
OPENVPN_PASSWORD=''
# Custom provider only: place the configuration in data/custom.ovpn.
# Set OPENVPN_CUSTOM_CONFIG=/gluetun/custom.ovpn when using that file.
OPENVPN_CUSTOM_CONFIG=''

# Firewall exceptions; empty keeps the default VPN-only outbound policy.
# Only add specific LAN subnets/ports required by attached services.
FIREWALL_OUTBOUND_SUBNETS=''
FIREWALL_INPUT_PORTS=8080,8081,5800

# qBittorrent Web UI is published by Gluetun; add your LAN CIDR above for replies.
QBITTORRENT_WEB_BIND_IP=0.0.0.0
QBITTORRENT_WEB_PORT=8080

# MeTube shares Gluetun networking; its Web UI port is published here.
METUBE_WEB_BIND_IP=0.0.0.0
METUBE_PORT=8081

# JDownloader browser GUI shares Gluetun networking.
JDOWNLOADER_WEB_BIND_IP=0.0.0.0
JDOWNLOADER_PORT=5800
