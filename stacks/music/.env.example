# User and time zone
PUID=1000
PGID=1000
TZ=Etc/UTC

# Storage
# Media root inside the container.
NAVIDROME_ROOT_FOLDER=/music
# Media root inside the container.
ARR_ROOT_FOLDER=/music
MUSIC_DIR=/media/music
# Use the same host directory for arr applications and qBittorrent.
SHARED_DOWNLOADS_DIR=/downloads

# Network and HTTP access
# DNS resolvers used by containers.
DNS_PRIMARY=1.1.1.1
DNS_SECONDARY=1.0.0.1
# Separate HTTP host names with semicolons; add your server IP if needed.
ARR_ALLOWED_HOSTS='localhost;127.0.0.1;lidarr;lidarr.arr.local'
# Comma-separated trusted proxy CIDRs; leave empty when no proxy is used.
ARR_TRUSTED_PROXIES=

# Arr application authentication
ARR_AUTH_METHOD=Forms
ARR_AUTH_REQUIRED=DisabledForLocalAddresses
ARR_AUTH_USERNAME='admin'
# Empty: keep the existing account. Set: apply credentials through the startup hook.
# Generate a password on Linux: openssl rand -hex 24
ARR_AUTH_PASSWORD=''

# Extra-file import
# Enable importing companion files alongside the main media file.
ARR_IMPORT_EXTRA_FILES=false
# Comma-separated extensions without leading dots, for example: srt,nfo,jpg
ARR_EXTRA_FILE_EXTENSIONS='srt'
