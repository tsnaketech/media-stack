# User and time zone
PUID=1000
PGID=1000
TZ=Europe/Paris

# Storage
# Media root inside the container.
SHELFMARK_ROOT_FOLDER=/books
# Media root inside the container.
CALIBRE_ROOT_FOLDER=/books
LIBRARY_DIR=/media/books
# Use the same host directory for arr applications and qBittorrent.
SHARED_DOWNLOADS_DIR=/downloads

# Network
# DNS resolvers used by containers.
DNS_PRIMARY=1.1.1.1
DNS_SECONDARY=1.0.0.1
