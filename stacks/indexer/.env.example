# User and time zone
PUID=1000
PGID=1000
TZ=Europe/Paris

# Network and HTTP access
# DNS resolvers used by containers.
DNS_PRIMARY=1.1.1.1
DNS_SECONDARY=1.0.0.1
WEB_BIND_IP=0.0.0.0
# Separate HTTP host names with semicolons; add your server IP if needed.
ARR_ALLOWED_HOSTS='localhost;127.0.0.1;prowlarr;prowlarr.arr.local'
# Comma-separated trusted proxy CIDRs; leave empty when no proxy is used.
ARR_TRUSTED_PROXIES=

# Prowlarr application registration (host setup script, run by stacks.sh up)
# fullSync makes Prowlarr authoritative for its synchronized indexers.
# Alternatives: addOnly or disabled. Empty per-app levels inherit the global value.
# Empty API keys are read locally; custom application URLs require explicit keys.
# ENABLED=false skips management and preserves an existing entry.
PROWLARR_APPS_SETUP_ENABLED=true
PROWLARR_APPS_PROWLARR_URL=http://prowlarr:9696
PROWLARR_APPS_SYNC_LEVEL=fullSync
PROWLARR_APP_LIDARR_ENABLED=true
PROWLARR_APP_LIDARR_URL=http://lidarr:8686
PROWLARR_APP_LIDARR_API_KEY=
PROWLARR_APP_LIDARR_SYNC_LEVEL=
PROWLARR_APP_RADARR_ENABLED=true
PROWLARR_APP_RADARR_URL=http://radarr:7878
PROWLARR_APP_RADARR_API_KEY=
PROWLARR_APP_RADARR_SYNC_LEVEL=
PROWLARR_APP_SONARR_ENABLED=true
PROWLARR_APP_SONARR_URL=http://sonarr:8989
PROWLARR_APP_SONARR_API_KEY=
PROWLARR_APP_SONARR_SYNC_LEVEL=

# FlareSolverr runtime (HTTP API, bound to the host loopback by default)
FLARESOLVERR_PORT=8191
FLARESOLVERR_BIND_IP=127.0.0.1
FLARESOLVERR_LOG_LEVEL=info
FLARESOLVERR_LOG_HTML=false

# FlareSolverr proxy in Prowlarr, applied by the host setup script
FLARESOLVERR_SETUP_ENABLED=true
FLARESOLVERR_URL=http://flaresolverr:8191
FLARESOLVERR_REQUEST_TIMEOUT=60
FLARESOLVERR_TAG=flaresolverr
# Optional CSV of exact indexer names to tag; empty preserves indexer settings.
FLARESOLVERR_INDEXERS=''

# Arr application authentication
ARR_AUTH_METHOD=Forms
ARR_AUTH_REQUIRED=DisabledForLocalAddresses
ARR_AUTH_USERNAME='admin'
# Empty: keep the existing account. Set: apply credentials through the startup hook.
# Generate a password on Linux: openssl rand -hex 24
ARR_AUTH_PASSWORD=''
