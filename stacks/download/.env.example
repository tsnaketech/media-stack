# User and time zone
PUID=1000
PGID=1000
TZ=Europe/Paris

# Storage
# Use the same host directory for arr applications and qBittorrent.
SHARED_DOWNLOADS_DIR=/downloads

# Network and HTTP access
# DNS resolvers used by containers.
DNS_PRIMARY=1.1.1.1
DNS_SECONDARY=1.0.0.1
WEB_BIND_IP=0.0.0.0

# Initializer only: used when qBittorrent has no existing configuration.
# Empty password: initialize.py prepare generates and stores a private password.
# Existing accounts are never changed by these variables.
QBITTORRENT_INIT_USERNAME=admin
QBITTORRENT_INIT_PASSWORD=''

# JOAL web interface; configuration comes from the official release archive.
JOAL_IMAGE_TAG=2.1.37
JOAL_PORT=8088
# Alphanumeric path component; generate with: openssl rand -hex 8
JOAL_UI_PATH='changeThisPathBeforeUse'
# Generate with: openssl rand -hex 24
JOAL_UI_SECRET_TOKEN=''
JOAL_JAVA_OPTIONS='-Xms64m -Xmx256m -Duser.home=/data'

# qui web interface and native session configuration
QUI_PORT=7476
QUI_LOG_LEVEL=INFO
# Generate with: openssl rand -hex 32
QUI_SESSION_SECRET=''
QUI_SESSION_COOKIE_SECURE=false

# qui account/client setup, applied by scripts/configure-qui.py on the host.
QUI_SETUP_ENABLED=true
QUI_USERNAME=admin
# Generate with: openssl rand -hex 24
QUI_PASSWORD=''
QUI_INSTANCE_NAME=qBittorrent
QUI_QBITTORRENT_URL=http://qbittorrent:8080
# Empty: read download/.qbittorrent-credentials.json.
QUI_QBITTORRENT_USERNAME=''
QUI_QBITTORRENT_PASSWORD=''

# qui integrations: empty API keys are read from local Sonarr/Radarr config files.
# Set an explicit API key when using a custom URL. Disabled entries are preserved.
QUI_SONARR_ENABLED=true
QUI_SONARR_URL=http://sonarr:8989
QUI_SONARR_API_KEY=''
QUI_RADARR_ENABLED=true
QUI_RADARR_URL=http://radarr:7878
QUI_RADARR_API_KEY=''

# SABnzbd Usenet client (provider and NZB indexer subscriptions are separate)
SABNZBD_PORT=8085
# The container startup hook applies these settings before SABnzbd starts.
SABNZBD_SETUP_ENABLED=true
SABNZBD_USERNAME=admin
# Generate with: openssl rand -hex 24
SABNZBD_PASSWORD=
SABNZBD_ALLOWED_HOSTS=sabnzbd,sabnzbd.arr.local,localhost
# Pause downloading when available space drops below this limit.
SABNZBD_MIN_FREE_SPACE=2G
# Optional additional category names, separated by commas.
SABNZBD_EXTRA_CATEGORIES=
# Leave the provider host empty until an account is available. TLS is enabled.
SABNZBD_SERVER_HOST=
SABNZBD_SERVER_PORT=563
SABNZBD_SERVER_SSL=true
SABNZBD_SERVER_USERNAME=
SABNZBD_SERVER_PASSWORD=
SABNZBD_SERVER_CONNECTIONS=8

# MeTube web downloader; host video destination.
METUBE_VIDEO_DIR=/downloads/youtube/videos
# The published port and bind address are configured in vpn/.env.
METUBE_LOG_LEVEL=INFO
METUBE_THEME=auto
METUBE_UMASK=002
METUBE_MAX_CONCURRENT_DOWNLOADS=2
# Keep downloaded files when removing an entry from the completed list.
METUBE_DELETE_FILE_ON_TRASHCAN=false
# yt-dlp Python API options as JSON; retain single quotes around the JSON value.
METUBE_YTDL_OPTIONS='{}'

# JDownloader browser GUI; files go to SHARED_DOWNLOADS_DIR/direct.
JDOWNLOADER_DOWNLOAD_PATH=/output
# false: do not add package or site subdirectories.
JDOWNLOADER_SUBFOLDERS=false
# Published port and bind address belong to vpn/.env.
JDOWNLOADER_IMAGE_TAG=latest
JDOWNLOADER_LANG=fr_FR.UTF-8
JDOWNLOADER_UMASK=0002
JDOWNLOADER_MAX_MEM=256M
JDOWNLOADER_USERNAME=admin
# Empty on a fresh installation: initialize.py prepare generates a private password.
# To generate manually: openssl rand -hex 24
JDOWNLOADER_PASSWORD=''
