# User and time zone
PUID=1000
PGID=1000
TZ=Etc/UTC

# Network and HTTP access
# DNS resolvers used by containers.
DNS_PRIMARY=1.1.1.1
DNS_SECONDARY=1.0.0.1
WEB_BIND_IP=0.0.0.0

# Native arr Connect -> Jellyfin library updates (host setup script).
# Empty key: create/reuse a dedicated Jellyfin key; custom URLs require an explicit key.
# Disable automatic management without deleting saved connections with ENABLED=false.
JELLYFIN_CONNECT_ENABLED=true
JELLYFIN_CONNECT_URL=http://jellyfin:8096
JELLYFIN_CONNECT_API_KEY=
JELLYFIN_CONNECT_LIDARR_ENABLED=true
# Music library path as seen by Jellyfin.
JELLYFIN_CONNECT_LIDARR_MAP_TO=/media/music
JELLYFIN_CONNECT_RADARR_ENABLED=true
JELLYFIN_CONNECT_SONARR_ENABLED=true
JELLYFIN_CONNECT_RADARR_MAP_FROM=/movies
JELLYFIN_CONNECT_RADARR_MAP_TO=/media/movies
JELLYFIN_CONNECT_SONARR_MAP_FROM=/tv
JELLYFIN_CONNECT_SONARR_MAP_TO=/media/tv

# Jellyfin runtime, administrator and library setup
JELLYFIN_IMAGE=lscr.io/linuxserver/jellyfin:latest
JELLYFIN_PORT=8096
JELLYFIN_DISCOVERY_PORT=7359
JELLYFIN_PUBLIC_URL='http://jellyfin.arr.local'
JELLYFIN_SETUP_ENABLED=true
JELLYFIN_SERVER_NAME=Homelab
JELLYFIN_ADMIN_USERNAME=admin
# Generate on Linux: openssl rand -hex 24. Required for first-time setup.
JELLYFIN_ADMIN_PASSWORD=''
# Filled automatically by configure-jellyfin.py; never commit real tokens.
JELLYFIN_API_KEY=''
# Existing host directories; all media mounts are read-only.
JELLYFIN_MOVIES_DIR=/media/movies
JELLYFIN_TV_DIR=/media/tv
JELLYFIN_MUSIC_DIR=/media/music
JELLYFIN_MOVIES_NAME=Films
JELLYFIN_TV_NAME='Séries'
JELLYFIN_MUSIC_NAME=Musique

# Jellyfin plugin repositories, registered by configure-jellyfin.py.
# Existing repository names and enabled states are preserved.
# Empty URL: skip that repository. false: skip all repository management.
JELLYFIN_PLUGIN_REPOSITORIES_ENABLED=true
JELLYFIN_ENHANCED_REPOSITORY=https://raw.githubusercontent.com/n00bcodr/jellyfin-plugins/main/manifest.json

# Seerr portal
SEERR_PORT=5055
SEERR_LOG_LEVEL=info

# Seerr settings managed by scripts/configure-seerr.py on the host.
SEERR_SETUP_ENABLED=true
# Bootstrap Seerr through the configured Jellyfin administrator login.
SEERR_BOOTSTRAP_WITH_JELLYFIN=true
SEERR_APPLICATION_TITLE=Seerr
SEERR_APPLICATION_URL='http://seerr.arr.local'
SEERR_LOCALE=fr
SEERR_DISCOVER_REGION=FR
SEERR_STREAMING_REGION=FR
SEERR_LOCAL_LOGIN=true
SEERR_MEDIA_SERVER_LOGIN=true

# Seerr -> Radarr (normal, non-4K server)
SEERR_CONFIGURE_RADARR=true
SEERR_RADARR_NAME=Radarr
SEERR_RADARR_URL=http://radarr:7878
# Empty: read the local Radarr API key automatically.
SEERR_RADARR_API_KEY=''
SEERR_RADARR_PROFILE='1080p Français'
# Must already exist as a root folder in Radarr.
SEERR_RADARR_ROOT_FOLDER=/movies
SEERR_RADARR_DEFAULT=true
SEERR_RADARR_SYNC_ENABLED=true
SEERR_RADARR_PREVENT_SEARCH=false
SEERR_RADARR_MINIMUM_AVAILABILITY=released

# Seerr -> Sonarr (normal, non-4K server)
SEERR_CONFIGURE_SONARR=true
SEERR_SONARR_NAME=Sonarr
SEERR_SONARR_URL=http://sonarr:8989
# Empty: read the local Sonarr API key automatically.
SEERR_SONARR_API_KEY=''
SEERR_SONARR_PROFILE='1080p Français'
# Must already exist as a root folder in Sonarr.
SEERR_SONARR_ROOT_FOLDER=/tv
SEERR_SONARR_DEFAULT=true
SEERR_SONARR_SYNC_ENABLED=true
SEERR_SONARR_PREVENT_SEARCH=false
SEERR_SONARR_SERIES_TYPE=standard
SEERR_SONARR_SEASON_FOLDERS=true

# Seerr media server; configure-jellyfin.py fills the key and library IDs.
# Use Docker-reachable URLs, without embedded passwords.
SEERR_MEDIA_SERVER_TYPE=jellyfin
SEERR_MEDIA_SERVER_URL='http://jellyfin:8096'
SEERR_MEDIA_SERVER_API_KEY=''
SEERR_MEDIA_SERVER_EXTERNAL_URL=''
# Comma-separated library IDs. Empty: preserve the previous library selection.
SEERR_MEDIA_SERVER_LIBRARY_IDS=''

# Profilarr quality profiles
UMASK=022
PROFILARR_PORT=6868
# Single canonical public URL used for login and forms.
PROFILARR_ORIGIN='http://profilarr.arr.local'
# Local login must remain enabled when applying credentials.
PROFILARR_AUTH=on

# Applied by scripts/configure-profilarr-auth.sh, not native Profilarr settings.
PROFILARR_USERNAME=admin
# Empty: preserve existing credentials. Generate: openssl rand -hex 24
PROFILARR_PASSWORD=''
# Required only to replace an existing password; clear after successful rotation.
PROFILARR_CURRENT_PASSWORD=''

# TMDB API Read Access Token (Bearer token), applied by configure-profilarr.py.
# Empty: preserve the token already configured in Profilarr.
PROFILARR_TMDB_API_TOKEN=''

# Host setup script: connect Profilarr to the two arr applications after startup.
PROFILARR_SETUP_ENABLED=true
# Link/synchronize the policy database for French profiles; preserve disabled databases.
PROFILARR_DATABASE_SETUP_ENABLED=true
PROFILARR_DATABASE_NAME=Dictionarry
PROFILARR_DATABASE_URL=https://github.com/Dictionarry-Hub/database
PROFILARR_RADARR_URL=http://radarr:7878
PROFILARR_SONARR_URL=http://sonarr:8989
# Empty: read each API key automatically from its Compose /config bind mount.
PROFILARR_RADARR_API_KEY=''
PROFILARR_SONARR_API_KEY=''

# Managed French-audio 1080p policy; applied by the host setup script.
PROFILARR_FRENCH_PROFILES_ENABLED=true
# Reassign existing films/series without searching for or replacing files.
PROFILARR_FRENCH_APPLY_EXISTING=false

# CSV list: outer single quotes preserve the individual double-quoted names.
PROFILARR_PROFILES='"1080p Français","2160p Français"'
PROFILARR_DEFAULT_PROFILE='1080p Français'

# Bazarr subtitle management, connected to Radarr/Sonarr by the host setup script.
BAZARR_PORT=6767
BAZARR_SETUP_ENABLED=true
BAZARR_USERNAME=admin
# Generate with: openssl rand -hex 24
BAZARR_PASSWORD=''
BAZARR_RADARR_URL=http://radarr:7878
# Empty: read the local Radarr API key.
BAZARR_RADARR_API_KEY=''
BAZARR_SONARR_URL=http://sonarr:8989
# Empty: read the local Sonarr API key.
BAZARR_SONARR_API_KEY=''
BAZARR_LANGUAGE_PROFILE='Français'
# Must match the host library directories used by Radarr/Sonarr; writable for subtitles.
BAZARR_MOVIES_DIR=/media/movies
BAZARR_TV_DIR=/media/tv
